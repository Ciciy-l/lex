<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Embedded into cindy-updater.exe via mt.exe at build time, replacing
  tauri-build's default manifest. See forge.config.ts patchUpdaterManifest().

  Why we override the manifest at all:
  The exe filename contains "update", which trips Windows' Program Compatibility
  Assistant (PCA) installer-detection heuristic. Without an explicit SupportedOS
  list, PCA monitors the process and pops "可能未正确安装此程序" / "This program
  might not have installed correctly" once it exits. Declaring SupportedOS for
  Vista..11 tells Windows "this app knows about modern Windows; do not apply
  legacy installer compatibility shims" — PCA detection is then bypassed.

  EVERYTHING ELSE in this file (dependentAssembly, dpiAware, longPathAware,
  trustInfo) mirrors tauri-build's defaults. Removing any of them breaks Tauri:
  - Common-Controls v6 dependency: required for TaskDialogIndirect to resolve
    at load time. Without it the exe fails to start with "无法定位程序输入点
    TaskDialogIndirect 于动态链接库 ... 上".
  - dpiAware: high-DPI monitor scaling for the Tauri window.
  - longPathAware: lets file ops bypass MAX_PATH (Tauri may stage temp paths
    longer than 260 chars).
  - asInvoker: cindy-updater self-elevates via ShellExecuteEx(verb="runas") only
    when it actually needs admin; we do NOT want UAC on every spawn.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity
    type="win32"
    name="com.ciciy.lex.updater"
    version="0.1.0.0"
    processorArchitecture="*"
  />

  <!-- ComCtl32 v6: required for TaskDialogIndirect and modern themed controls.
       MUST stay in sync with tauri-build's default. -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"
      />
    </dependentAssembly>
  </dependency>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/PM</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Vista -->
      <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}"/>
      <!-- 7 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
      <!-- 8 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <!-- 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <!-- 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
